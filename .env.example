# Active profile for Docker/CI (run-local.ps1 sets `local` for Maven)
SPRING_PROFILES_ACTIVE=local

# Local-only auth toggles. Production hardcodes secure cookies and hides reset tokens.
AUTH_COOKIE_SECURE=false
AUTH_EXPOSE_RESET_TOKEN=true

# Local database (docker compose)
DB_URL=jdbc:postgresql://localhost:55432/devstreak
DB_USER=devstreak
DB_PASS=devstreak

# JWT (base64-encoded 32 bytes)
JWT_SECRET=AQIDBAUGBwgJCgsMDQ4PEBESExQVFhcYGRobHB0eHyA=
JWT_ISSUER=devrats-api
JWT_ACCESS_TTL=PT15M
JWT_REFRESH_TTL=P30D

# GitHub token encryption (base64-encoded 32 bytes)
TOKEN_ENCRYPTION_KEY=ICEiIyQlJicoKSorLC0uLzAxMjM0NTY3ODk6Ozw9Pj8=
TOKEN_ENCRYPTION_KEY_ID=1

# GitHub App (fill in after creating the App)
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_SLUG=devrats
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_CALLBACK_URL=http://localhost:8080/api/v1/integrations/github/callback
GITHUB_SETUP_URL=http://localhost:8080/api/v1/integrations/github/setup

# CORS
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
APP_FRONTEND_URL=http://localhost:5173

# Friendships and presence (optional; defaults in parentheses)
APP_FRIENDS_MAX_PER_USER=1000
APP_FRIENDS_MAX_PENDING_OUTGOING=50
APP_FRIENDS_DECLINED_COOLDOWN=PT72H
APP_PRESENCE_ONLINE_WINDOW=PT2M
APP_PRESENCE_AWAY_WINDOW=PT10M
APP_SOCIAL_SEARCH_PER_MINUTE=20
APP_SOCIAL_FRIEND_REQUEST_PER_HOUR=10

# S3-compatible storage for profile pictures (R2/MinIO/AWS).
# Leave bucket and credentials empty to disable uploads (the API still starts).
APP_STORAGE_ENDPOINT=
APP_STORAGE_REGION=auto
APP_STORAGE_BUCKET=
APP_STORAGE_ACCESS_KEY=
APP_STORAGE_SECRET_KEY=
APP_STORAGE_PUBLIC_BASE_URL=
APP_STORAGE_KEY_PREFIX=avatars

# Chat: attachments in a private bucket (images, voice, and documents).
# Without a bucket, text chat keeps working and uploads return 503.
APP_CHAT_STORAGE_BUCKET=
APP_CHAT_STORAGE_KEY_PREFIX=chat
APP_CHAT_ATTACHMENT_URL_TTL=PT15M
APP_CHAT_MAX_TEXT_CHARS=2000
APP_CHAT_MAX_IMAGE_BYTES=8388608
APP_CHAT_MAX_VOICE_BYTES=16777216
APP_CHAT_MAX_FILE_BYTES=20971520
APP_CHAT_MAX_VOICE_SECONDS=300
APP_CHAT_MESSAGES_PER_MINUTE=30
APP_CHAT_UPLOADS_PER_MINUTE=10
APP_CHAT_TYPING_THROTTLE=PT2S
APP_CHAT_MAX_SESSIONS_PER_USER=5

# Study photos: private bucket, one photo per participant/day.
APP_STUDY_PHOTOS_ENABLED=true
APP_STUDY_PHOTOS_STORAGE_BUCKET=
APP_STUDY_PHOTOS_STORAGE_KEY_PREFIX=study-photos
APP_STUDY_PHOTOS_MAX_IMAGE_BYTES=8388608
APP_STUDY_PHOTOS_URL_TTL=PT15M
APP_RATE_LIMIT_PHOTO_UPLOAD_CAPACITY=20
APP_RATE_LIMIT_PHOTO_UPLOAD_REFILL=PT1H

# Cloudflare Turnstile (register/login/password reset).
APP_TURNSTILE_ENABLED=false
CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=
CLOUDFLARE_TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
CLOUDFLARE_TURNSTILE_TIMEOUT=PT5S
CLOUDFLARE_TURNSTILE_FAIL_OPEN=false

# Transactional e-mail (Resend). Without a key, sending is disabled.
# off = do not send; test = send to EMAIL_TEST_RECIPIENT; live = send to the user.
RESEND_API_KEY=
EMAIL_MODE=off
EMAIL_FROM=DevRats <onboarding@resend.dev>
EMAIL_REPLY_TO=
EMAIL_TEST_RECIPIENT=
EMAIL_TIMEOUT=PT10S
RESEND_BASE_URL=https://api.resend.com

# Password reset
APP_AUTH_RESET_TOKEN_TTL=PT30M
APP_AUTH_RESET_REQUEST_COOLDOWN=PT1M
